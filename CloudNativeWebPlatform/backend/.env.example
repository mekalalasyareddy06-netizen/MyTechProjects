DB_HOST=localhost
DB_PORT=3306
DB_USER=platform_user
DB_PASSWORD=platform_pass
DB_NAME=cloud_native_platform

JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRE_MINUTES=10080

S3_BUCKET=cloud-native-platform-attachments
S3_REGION=us-east-1
# Leave S3_ENDPOINT_URL unset to talk to real AWS S3.
# Point it at MinIO for local dev, e.g. http://localhost:9000
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

CLIENT_ORIGIN=http://localhost:5173
